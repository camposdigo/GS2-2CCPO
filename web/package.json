{
  "name": "territorio-vivo-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Painel territorial e API de ocorrências do projeto integrado Território Vivo.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:mongo": "node scripts/smoke-mongo.mjs",
    "test:browser": "node scripts/browser-qa.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "mongoose": "9.12.1",
    "multer": "2.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "7.3.2"
  }
}
