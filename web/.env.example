# Para Application Development, use MongoDB (por exemplo, o serviço do compose da raiz).
MONGO_URI=mongodb://127.0.0.1:27017/territorio_vivo
DEMO_MODE=false
PORT=3000
CLASSIFIER_URL=http://127.0.0.1:8001
# Vazio = somente mesma origem. Para Flutter web local, descomente:
# CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
CORS_ORIGINS=
# Somente para demonstração offline, altere explicitamente DEMO_MODE=true.
# Esse modo salva dados sintéticos em JSON e NÃO comprova o requisito MongoDB.
